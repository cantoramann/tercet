{
  "name": "tercet",
  "version": "0.4.0",
  "description": "A small, secure Next.js framework for publishing poetry.",
  "keywords": [
    "poetry",
    "poems",
    "nextjs",
    "next",
    "react",
    "framework",
    "static-site",
    "isr",
    "markdown",
    "accessibility"
  ],
  "homepage": "https://github.com/cantoramann/tercet/tree/main/packages/tercet#readme",
  "bugs": {
    "url": "https://github.com/cantoramann/tercet/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cantoramann/tercet.git",
    "directory": "packages/tercet"
  },
  "license": "MIT",
  "author": "Can Toraman",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./storage": {
      "types": "./dist/storage/index.d.ts",
      "default": "./dist/storage/index.js"
    },
    "./next": {
      "types": "./next/index.d.ts",
      "default": "./next/index.mjs"
    },
    "./styles.css": "./dist/styles.css",
    "./missing-s3-sdk": "./dist/storage/s3/missing-sdk.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "tercet": "dist/bin/tercet.js"
  },
  "files": [
    "dist",
    "next",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css",
    "./dist/storage/s3/missing-sdk.js"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp src/styles.css dist/styles.css && bun build bin/tercet.ts --target=node --outfile dist/bin/tercet.js --external @aws-sdk/client-s3 && chmod +x dist/bin/tercet.js",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun test",
    "prepack": "bun run build"
  },
  "peerDependencies": {
    "next": ">=16.4.6 <17",
    "react": ">=19.3.1 <20",
    "react-dom": ">=19.3.1 <20",
    "@aws-sdk/client-s3": ">=3.700.0 <4"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-s3": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1167.0",
    "@types/bun": "1.3.14",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
